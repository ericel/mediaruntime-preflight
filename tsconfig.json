{
  "compilerOptions": {
    // Use modern JavaScript and browser API definitions.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // Vite handles module resolution and bundling.
    "module": "ESNext",
    "moduleResolution": "Bundler",

    // TypeScript checks our code; Vite generates JavaScript.
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,

    // Support tooling imports and JSON modules.
    "esModuleInterop": true,
    "resolveJsonModule": true,

    // Check our code without rechecking dependency declarations.
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Node types support build configs and test fixtures.
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "examples/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-demo",
    "playwright-report",
    "test-results"
  ]
}